{
  "name": "opendata-mcp",
  "version": "0.2.0",
  "description": "MCP server for the OpenData Platform API. Tools are generated dynamically from the bundled OpenAPI 3.1 spec.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opendata-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skeego/opendata-mcp.git"
  },
  "license": "MIT"
}
