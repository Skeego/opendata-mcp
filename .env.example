# Base URL of the OpenData Platform API (no trailing slash).
# Production: https://api.tryopendata.ai
OPENDATA_BASE_URL=https://api.tryopendata.ai

# Bearer token for non-GET (POST/PUT/PATCH/DELETE) endpoints. GET endpoints
# do not require auth. Treat as a secret — never commit a real key.
OPENDATA_API_KEY=

# Optional: filter exposed tools to GET-only (read-only MCP). Default false.
# OPENDATA_READ_ONLY=true

# Optional: per-request timeout in ms (default 30000).
# OPENDATA_TIMEOUT_MS=30000

# Optional: total HTTP attempts incl. initial, for transient failures only
# (502/503/504 and network errors). 500/4xx are NOT retried. Default 3.
# OPENDATA_MAX_ATTEMPTS=3

# Optional: log level (off|error|info|debug). Default info. Logs are
# structured JSON lines on stderr (stdout is reserved for the MCP protocol).
# OPENDATA_LOG_LEVEL=info
